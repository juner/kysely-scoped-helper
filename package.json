{
  "name": "kysely-scoped-helper",
  "version": "1.0.2",
  "description": "kysely + explicit resource management helper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest watch --coverage",
    "test:runtime": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "test": "npm run test:types && npm run test:coverage",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juner/kysely-scoped-helper.git"
  },
  "bugs": {
    "url": "https://github.com/juner/kysely-scoped-helper/issues"
  },
  "homepage": "https://github.com/juner/kysely-scoped-helper#readme",
  "keywords": [
    "kysely",
    "typescript",
    "async-disposable",
    "transaction",
    "using",
    "disposable",
    "explicit-resource-management",
    "savepoint"
  ],
  "author": "juner",
  "license": "MIT",
  "peerDependencies": {
    "kysely": "^0.29.8"
  },
  "overrides": {
    "minimatch": "^11.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.14.0",
    "jiti": "2.7.0",
    "kysely": "0.29.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
