{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"*.ts": "${capture}.js, ${capture}.*.ts",
		},
		"coverage-gutters.coverageFileNames": [
			"cobertura-coverage.xml",
			"coverage.cobertura.xml",
			"coverage-final.json"
		],
	},
	"extensions": {
		"recommendations": [
			"vitest.explorer",
			"ryanluker.vscode-coverage-gutters"
		]
	},
}