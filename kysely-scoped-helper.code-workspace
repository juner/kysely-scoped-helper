{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"explorer.fileNesting.enabled": true,
		"explorer.fileNesting.patterns": {
			"*.ts": "${capture}.js, ${capture}.*.ts",
		},
		"coverage-gutters.coverageFileNames": [
			"coverage.lcov",
			"lcov.info",
			"cov.xml",
			"coverage.xml",
			"cobertura.xml",
			"jacoco.xml",
			"coverage.cobertura.xml"
		],
	},
	"extensions": {
		"recommendations": [
			"ryanluker.vscode-coverage-gutters"
		]
	},
}